# Copy to .env and fill in. Alchemy deploys these as Worker secrets.
OWNER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=

# Optional: serve the app on this hostname, on a Cloudflare zone in the same
# account. Not a secret.
# CUSTOM_DOMAIN=calendar.example.com

# Optional: the Alchemy profile that holds your Cloudflare login. Defaults to
# "default". Not a secret.
# ALCHEMY_PROFILE=default
